# Copy to .env.local for local development. Never commit real values.

# Resend API key, from the marketing site's Resend account. Without it the request
# form says it isn't connected yet and points people to the founders' email.
RESEND_API_KEY=

# Optional overrides. Defaults: from "Brand resources <brand@send.compass-design.studio>",
# to allison@ and canyon@compass-design.studio. REQUEST_TO_EMAIL takes a comma-separated list.
REQUEST_FROM_EMAIL=
REQUEST_TO_EMAIL=

# Optional secret for signing the form's fill-time token. Falls back to RESEND_API_KEY.
REQUEST_FORM_SECRET=

# Set to 1 to log requests instead of sending them (local testing).
REQUEST_DRY_RUN=

# Testimonial uploads. Vercel adds this when a private Blob store is connected to the
# project; `vercel env pull` brings it here. Without it the testimonial page asks clients
# to reply to our email with their video instead.
BLOB_READ_WRITE_TOKEN=

# Copy each uploaded video and its sign-off to Google Drive, then delete it from Blob
# (README, "Testimonial uploads").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
